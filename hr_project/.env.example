# Copy this file to .env and fill in your own values.
# .env is already in .gitignore — never commit real credentials.

# PostgreSQL connection (recommended for real use). Format:
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://hr_user:hr_pass@localhost:5432/hr_db

# If DATABASE_URL is left unset entirely, the app falls back to a local
# SQLite file (app.db) so it can be test-run without a Postgres server.

SECRET_KEY=change-me-in-production
